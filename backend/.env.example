# Database Configuration
# Choose your database type: 'sqlite' or 'postgresql'
DATABASE_TYPE=sqlite

# ============================================
# SQLite Configuration (Local Development)
# ============================================
# Uncomment and set the database file path for SQLite
DATABASE_PATH=certificates.db

# ============================================
# PostgreSQL/Supabase Configuration (Production)
# ============================================
# Uncomment and set your Supabase/PostgreSQL connection string
# Format: postgresql://postgres.[project-ref]:[password]@[host]:[port]/postgres
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YourPassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ============================================
# Example: Using Supabase PostgreSQL
# ============================================
# 1. Create a Supabase project at https://supabase.com
# 2. Get your connection string from Settings > Database > Connection string (URI mode)
# 3. Set DATABASE_TYPE=postgresql
# 4. Set DATABASE_URL with your connection string
# 5. Run the SQL in SUPABASE_SETUP.md to create the templates table

# DATABASE_TYPE=postgresql
# DATABASE_URL=your-supabase-connection-string-here

# ============================================
# Instructions
# ============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. NEVER commit .env to git (it's in .gitignore)
# 4. For local development, use SQLite (default)
# 5. For production, use PostgreSQL/Supabase
